# Schützt serverseitige Secret-Dateien, falls sie versehentlich im Webroot liegen.
# (Der eigentliche, sichere Ablageort ist OBERHALB des Webroots – siehe api/lead.php.)
<FilesMatch "(pipedrive-token|meta-capi-token|meta-test-code|pd-webhook-secret)\.txt$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
